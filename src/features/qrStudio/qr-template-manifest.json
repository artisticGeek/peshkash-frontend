{
  "version": "3.1.0",
  "librarySize": 30,
  "coordinateSystem": "normalized-0-to-1",
  "sizeReference": "shorter-canvas-side",
  "assetPattern": "SVG/Template-Library/{styleFolder}/{file}",
  "qrStandard": {
    "quietZoneModules": 4,
    "foreground": "#1A1410",
    "background": "#FFFFFF",
    "errorCorrection": "H required",
    "moduleShape": "rounded-square",
    "finderShape": "rounded-square-with-round-core",
    "approvedLogoOverlay": "compact-framed-P-medallion",
    "minimumPrintSizeMm": 24,
    "minimumDigitalSizePx": 160,
    "minimumRasterModulePixels": 4,
    "recommendedPrintModuleMm": 0.4,
    "destinationPolicy": "short-owned-https-redirect"
  },
  "qrStyles": {
    "obsidian-ring": {
      "label": "Obsidian Ring",
      "folder": "Obsidian-Ring",
      "medallion": "compact near-black seal with white isolation ring",
      "moduleRadiusCells": 0.28,
      "finderRadiusCells": 1.35,
      "medallionFill": "#1A1410",
      "medallionStroke": "#BB9057",
      "medallionRatio": 0.12,
      "medallionIconRatio": 0.64,
      "isolationInnerRatio": 0.91,
      "finderCore": "#6F4A2C",
      "maskPolicy": "minimize-center-overlay-damage",
      "required": true
    },
    "porcelain-cameo": {
      "label": "Porcelain Cameo",
      "folder": "Porcelain-Cameo",
      "medallion": "compact cream cameo with warm stone edge",
      "moduleRadiusCells": 0.27,
      "finderRadiusCells": 1.35,
      "medallionFill": "#F5F2EE",
      "medallionStroke": "#C5AF9D",
      "medallionRatio": 0.172,
      "medallionIconRatio": 0.62,
      "finderCore": "#1A1410",
      "maskPolicy": "encoder-default",
      "required": true
    }
